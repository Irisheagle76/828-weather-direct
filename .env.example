# Existing private admin authentication
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=choose-a-long-random-session-value

# Existing Tempest integration
TEMPEST_STATION_ID=your-weatherflow-station-id
TEMPEST_TOKEN=your-weatherflow-api-token

# Phase 1 NWS identification (include a monitored contact address in production)
NWS_USER_AGENT=828 Weather Nowcast Console (contact@example.com)

# Explicit development/testing switch. Never enable unintentionally in production.
NOWCAST_MOCK_MODE=false

# Upstash Redis credentials are provisioned by the existing Vercel integration.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

DRIVENC_API_KEY=your-drivenc-developer-key
DRIVENC_EMAIL_INGEST_SECRET=choose-a-long-random-secret

# Automatic Forecast Vacation Mode (Vercel production environment)
AUTO_FORECAST_ENABLED=false
AUTO_FORECAST_START=2026-07-13T00:00:00-04:00
AUTO_FORECAST_END=2026-07-26T08:00:00-04:00
AUTO_FORECAST_TIMEZONE=America/New_York
AUTO_FORECAST_MANUAL_OVERRIDE_HOURS=6
AUTO_FORECAST_LATITUDE=35.5951
AUTO_FORECAST_LONGITUDE=-82.5515
CRON_SECRET=choose-a-long-random-secret

# Server-only elevation observation providers
WEATHERFLOW_API_KEY=your-weatherflow-api-key
WEATHER_UNDERGROUND_API_KEY=your-weather-underground-api-key
# Existing deployments may provide WEATHER_UNDERGROUND_API_KEY as WU_API_KEY.

# Optional override for the normalized last-good observation artifact
FALL_OBSERVATIONS_URL=https://raw.githubusercontent.com/Irisheagle76/828-weather-direct/main/public/data/hiking-guidance.json
