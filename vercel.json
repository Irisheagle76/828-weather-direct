{
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/admin/page.js": {
      "includeFiles": "public/admin/**"
    }
  },
  "crons": [
    { "path": "/api/router?route=forecast/automatic", "schedule": "15 9 * * *" },
    { "path": "/api/router?route=forecast/automatic", "schedule": "15 19 * * *" }
  ],
  "routes": [
    {
      "src": "/admin/?",
      "dest": "/api/admin/page?path=index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/admin/page?path=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
